# Copy to .env (never commit .env). Leave blank to run in offline / dry-run mode.

# Claude document reader. Without it the offline heuristic reader is used (low confidence).
ANTHROPIC_API_KEY=
SCOUT_CLAUDE_MODEL=claude-opus-5-5
SCOUT_CLAUDE_FALLBACKS=true

# Email digests. Without SMTP settings digests are written to data/outbox/ (dry run).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=you@example.com

# eMMA notification intake: an inbox you own that receives eMMA emails.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SENDER_FILTER=emma

# Optional overrides
SCOUT_TIMEZONE=America/New_York
# SCOUT_DATA_DIR=./data
